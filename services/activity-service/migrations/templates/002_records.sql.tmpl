-- user_id % 4 = __SHARD__; rendered by scripts/Generate-RecordMigrations.ps1.
CREATE TABLE draw_order___SHARD__ (
    draw_id BIGINT UNSIGNED NOT NULL,
    user_id BIGINT UNSIGNED NOT NULL,
    edition_id BIGINT UNSIGNED NOT NULL,
    round_no INT UNSIGNED NOT NULL,
    operation_id VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    mode VARCHAR(16) NOT NULL,
    preview_id BIGINT UNSIGNED NULL,
    pool_code VARCHAR(8) NOT NULL,
    rule_version INT UNSIGNED NOT NULL,
    requested_count SMALLINT UNSIGNED NOT NULL,
    actual_count SMALLINT UNSIGNED NOT NULL,
    unit_petal_cost BIGINT NOT NULL COMMENT 'Execution price snapshot; do not hardcode default prices',
    charged_petals BIGINT NOT NULL,
    refunded_petals BIGINT NOT NULL DEFAULT 0,
    consumed_petals BIGINT NOT NULL,
    flowers_added TINYINT UNSIGNED NOT NULL,
    has_flower TINYINT GENERATED ALWAYS AS (flowers_added > 0) STORED,
    reward_snapshot_json JSON NOT NULL COMMENT 'Immutable ordered original per-draw rewards',
    draw_seq BIGINT UNSIGNED NOT NULL,
    occurred_at DATETIME(6) NOT NULL,
    PRIMARY KEY (draw_id),
    UNIQUE KEY uk_draw_operation (user_id, operation_id),
    UNIQUE KEY uk_draw_preview (user_id, preview_id),
    UNIQUE KEY uk_draw_sequence (user_id, edition_id, draw_seq),
    KEY idx_draw_history (user_id, edition_id, pool_code, occurred_at DESC, draw_id DESC),
    KEY idx_draw_flowers (user_id, edition_id, has_flower, occurred_at DESC, draw_id DESC),
    KEY idx_draw_settlement (edition_id, draw_id),
    CHECK (user_id > 0 AND MOD(user_id, 4) = __SHARD__),
    CHECK (round_no > 0 AND rule_version > 0 AND draw_seq > 0),
    CHECK (pool_code IN ('DAY', 'NIGHT')),
    CHECK (actual_count BETWEEN 1 AND requested_count AND flowers_added <= 18),
    CHECK (unit_petal_cost > 0 AND refunded_petals >= 0),
    CHECK (consumed_petals = actual_count * unit_petal_cost),
    CHECK (charged_petals = consumed_petals + refunded_petals),
    CHECK ((mode = 'NORMAL' AND requested_count IN (1, 10, 30) AND preview_id IS NULL AND charged_petals = requested_count * unit_petal_cost)
        OR (mode = 'PREVIEW' AND requested_count = 180 AND pool_code = 'DAY' AND preview_id IS NOT NULL AND refunded_petals = 0)),
    CHECK (JSON_TYPE(reward_snapshot_json) = 'ARRAY' AND JSON_LENGTH(reward_snapshot_json) = actual_count)
) ENGINE=InnoDB COMMENT='Committed formal draw batches, shard __SHARD__';

CREATE TABLE draw_detail___SHARD__ (
    detail_id BIGINT UNSIGNED NOT NULL,
    user_id BIGINT UNSIGNED NOT NULL,
    edition_id BIGINT UNSIGNED NOT NULL,
    draw_id BIGINT UNSIGNED NOT NULL,
    draw_no SMALLINT UNSIGNED NOT NULL,
    original_reward_code VARCHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    original_item_name VARCHAR(128) NOT NULL,
    quantity BIGINT NOT NULL,
    petal_cost BIGINT NOT NULL,
    flowers_before TINYINT UNSIGNED NOT NULL,
    probability_lit TINYINT UNSIGNED NOT NULL,
    guarantee_lit TINYINT UNSIGNED NOT NULL,
    flowers_after TINYINT UNSIGNED NOT NULL,
    cumulative_gold_equivalent BIGINT NOT NULL,
    PRIMARY KEY (detail_id),
    UNIQUE KEY uk_detail_draw (user_id, draw_id, draw_no),
    CHECK (user_id > 0 AND MOD(user_id, 4) = __SHARD__),
    CHECK (draw_no BETWEEN 1 AND 180 AND quantity > 0 AND petal_cost > 0),
    CHECK (flowers_before < 18 AND flowers_after <= 18 AND probability_lit <= 1),
    CHECK (flowers_after = flowers_before + probability_lit + guarantee_lit),
    CHECK (cumulative_gold_equivalent >= petal_cost * 60)
) ENGINE=InnoDB COMMENT='Every executed draw, including zero-flower draws, shard __SHARD__';

CREATE TABLE flower_lit_log___SHARD__ (
    log_id BIGINT UNSIGNED NOT NULL,
    user_id BIGINT UNSIGNED NOT NULL,
    edition_id BIGINT UNSIGNED NOT NULL,
    round_no INT UNSIGNED NOT NULL,
    draw_id BIGINT UNSIGNED NOT NULL,
    draw_no SMALLINT UNSIGNED NOT NULL,
    pool_code VARCHAR(8) NOT NULL,
    flowers_added TINYINT UNSIGNED NOT NULL,
    flowers_after TINYINT UNSIGNED NOT NULL,
    created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    PRIMARY KEY (log_id),
    UNIQUE KEY uk_flower_draw (user_id, draw_id, draw_no),
    KEY idx_flower_history (user_id, edition_id, created_at DESC, log_id DESC),
    CHECK (user_id > 0 AND MOD(user_id, 4) = __SHARD__),
    CHECK (round_no > 0 AND draw_no BETWEEN 1 AND 180),
    CHECK (pool_code IN ('DAY', 'NIGHT')),
    CHECK (flowers_added BETWEEN 1 AND 18 AND flowers_after BETWEEN flowers_added AND 18)
) ENGINE=InnoDB COMMENT='One row per draw with positive flower increment, shard __SHARD__';

CREATE TABLE wallet_ledger___SHARD__ (
    ledger_id BIGINT UNSIGNED NOT NULL,
    user_id BIGINT UNSIGNED NOT NULL,
    edition_id BIGINT UNSIGNED NULL COMMENT 'NULL for account initialization',
    asset_type VARCHAR(8) NOT NULL,
    delta BIGINT NOT NULL,
    balance_after BIGINT NOT NULL,
    reason VARCHAR(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL COMMENT 'Separate charge, batch wins, refund, purchase, stage and initialization reasons',
    biz_type VARCHAR(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
    biz_id BIGINT UNSIGNED NOT NULL,
    entry_no SMALLINT UNSIGNED NOT NULL,
    user_ledger_seq BIGINT UNSIGNED NOT NULL,
    created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
    PRIMARY KEY (ledger_id),
    UNIQUE KEY uk_ledger_business (user_id, biz_type, biz_id, entry_no),
    UNIQUE KEY uk_ledger_sequence (user_id, user_ledger_seq),
    CHECK (user_id > 0 AND MOD(user_id, 4) = __SHARD__),
    CHECK (asset_type IN ('GOLD', 'PETAL')),
    CHECK (delta <> 0 AND balance_after >= 0 AND entry_no > 0 AND user_ledger_seq > 0)
) ENGINE=InnoDB COMMENT='Signed asset changes and per-entry balances, shard __SHARD__';
